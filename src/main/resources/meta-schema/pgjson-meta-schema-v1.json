{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pgjson.bitbucket.io/meta-schema/v1",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": false,
    "https://pgjson.bitbucket.io/vocab/indexing/v1": true,
    "https://pgjson.bitbucket.io/vocab/ui/v1": true
  },
  "allOf": [
    {"$ref": "https://json-schema.org/draft/2020-12/schema"}
  ],
  "$defs": {
    "indexHint": {
      "type": "string",
      "enum": ["exact", "fts", "object", "nestedobject"],
      "description": "PostgreSQL index type hint for optimal query performance"
    },
    "uiLabel": {
      "type": "object",
      "description": "Internationalized UI labels using language codes",
      "patternProperties": {
        "^[a-z]{2}(-[A-Z]{2})?$": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
